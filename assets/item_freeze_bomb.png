<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <defs>
    <linearGradient id="iceBomb" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00d2d3"/>
      <stop offset="100%" stop-color="#0984e3"/>
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
      <feMerge><feMergeNode in="coloredBlur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <g filter="url(#glow)">
    <path d="M 50 25 Q 60 10, 75 15" fill="none" stroke="#ffa502" stroke-width="4" stroke-linecap="round"/>
    <circle cx="75" cy="15" r="4" fill="#ff4757"/>
    <circle cx="50" cy="55" r="32" fill="url(#iceBomb)" stroke="#2f3542" stroke-width="3"/>
    <path d="M 50 30 V 80 M 30 50 L 70 60 M 30 60 L 70 50" stroke="#ffffff" stroke-width="3" stroke-linecap="round"/>
    <circle cx="50" cy="55" r="6" fill="#ffffff"/>
  </g>
</svg>
