<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <defs>
    <linearGradient id="shieldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#70a1ff"/>
      <stop offset="100%" stop-color="#1e90ff"/>
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
      <feMerge><feMergeNode in="coloredBlur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <path d="M 50 10 L 85 25 L 85 55 C 85 75, 50 90, 50 90 C 50 90, 15 75, 15 55 L 15 25 Z" fill="url(#shieldGrad)" stroke="#ffffff" stroke-width="3" filter="url(#glow)"/>
  <path d="M 50 25 L 70 35 L 70 55 C 70 68, 50 78, 50 78 C 50 78, 30 68, 30 55 L 30 35 Z" fill="none" stroke="#ffffff" stroke-width="2" opacity="0.7"/>
</svg>
